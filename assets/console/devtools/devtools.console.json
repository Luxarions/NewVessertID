{
  "name": "devtools", "version": "1.0.0", "author": "Prasetyo Bayu", "license": "MIT",
  "extends": "default", "theme": "light", "layout": "docked-bottom", "keymap": "vscode", "locale": "en",
  "font": { "family": "Menlo, monospace", "size": 12, "lineHeight": 1.4 },
  "levels": {
    "log":   { "color": "#202124" },
    "info":  { "color": "#1a73e8" },
    "warn":  { "color": "#f9ab00" },
    "error": { "color": "#d93025" }
  },
  "features": { "timestamp": false, "stackTrace": true, "showLineNumbers": true, "maxLines": 10000 }
}
